# Copy this file to .env and fill in real values. .env is git-ignored: never commit it.

# Flagsmith API base URL. Flagsmith Cloud is shown; for self-hosted use e.g. http://localhost:8000/api/v1
FLAGSMITH_API_URL=https://api.flagsmith.com/api/v1

# Server-side environment key (starts with "ser."). Used by the demo shop to read flags.
# Use the key of the same environment the shop reports as (SHOP_ENVIRONMENT).
FLAGSMITH_SERVER_KEY=

# Organisation API key (Organisation Settings > API Keys). Used ONLY by the FlagGuard server to switch
# flags off. Required once dry_run is false in flagguard.yml. Check it with: npm run check:flagsmith
# Least privilege: this key never goes into an app.
FLAGSMITH_ADMIN_API_KEY=

# Key that apps must send to report to FlagGuard. Can only send reports, nothing else.
# At least 16 characters; FlagGuard refuses to start otherwise. Generate: openssl rand -hex 24
FLAGGUARD_INGEST_KEY=

# Path to the config file (default: flagguard.yml in the current folder)
FLAGGUARD_CONFIG=flagguard.yml

# Where alerts go (optional; both can be set). Keep these secret: anyone with the URL can post.
# Discord: channel > Edit Channel > Integrations > Webhooks > New Webhook > Copy Webhook URL
DISCORD_WEBHOOK_URL=
# Any URL that accepts a JSON POST (Slack bridge, Zapier, your own API)
ALERT_WEBHOOK_URL=

# Permanent record of every kill and failure, one JSON object per line
FLAGGUARD_AUDIT_LOG=data/audit.jsonl

# Port the FlagGuard server listens on
PORT=4000

# Demo shop (examples/demo-shop)
SHOP_PORT=3000
SHOP_ENVIRONMENT=development
# Share of users who get the new checkout while new_checkout is ON; the rest are the baseline
SHOP_ROLLOUT_PERCENT=50
FLAGGUARD_URL=http://localhost:4000
