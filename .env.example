# Copy this file to .env and fill in real values. .env is git-ignored: never commit it.

# Flagsmith API base URL. Flagsmith Cloud is shown; for self-hosted use e.g. http://localhost:8000/api/v1
FLAGSMITH_API_URL=https://api.flagsmith.com/api/v1

# Server-side environment key (starts with "ser."). Used by the demo shop to read flags.
FLAGSMITH_SERVER_KEY=

# Admin API key (Organisation Settings > API Keys). Used ONLY by the FlagGuard server to switch flags off.
# Least privilege: this key never goes into an app.
FLAGSMITH_ADMIN_API_KEY=

# Key that apps must send to report to FlagGuard. Can only send reports, nothing else.
# At least 16 characters; FlagGuard refuses to start otherwise. Generate: openssl rand -hex 24
FLAGGUARD_INGEST_KEY=

# Path to the config file (default: flagguard.yml in the current folder)
FLAGGUARD_CONFIG=flagguard.yml

# Where alerts go (optional). Discord: Server Settings > Integrations > Webhooks.
DISCORD_WEBHOOK_URL=

# Port the FlagGuard server listens on
PORT=4000
